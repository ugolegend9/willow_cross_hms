# Local development. For any real deployment set DEBUG=False and a long random SECRET_KEY.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=sqlite for a zero-setup local run with no MySQL server needed yet.
DB_ENGINE=mysql
DB_NAME=willow_cross_hms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Only used when DEBUG=False (see "Production hardening" in config/settings.py):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# BEHIND_PROXY=False

# Printed on invoices and shown in the admin header:
# HOSPITAL_NAME=Willow Cross Hospital
# HOSPITAL_ADDRESS=12 Example Road, Onitsha, Anambra
# HOSPITAL_PHONE=+234 800 000 0000

# --- Vercel + Aiven MySQL ----------------------------------------------------
# Set these in Vercel > Project > Settings > Environment Variables (not in a file):
#   SECRET_KEY=<long random string>      DEBUG=False
#   DATABASE_URL=<Aiven "Service URI", e.g. mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED>
#   DB_SSL_CA_PEM=<paste the full contents of Aiven's ca.pem>
#   ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS  (only for a custom domain; *.vercel.app is automatic)
# Locally you can instead save Aiven's CA as certs/ca.pem and just set DATABASE_URL.
